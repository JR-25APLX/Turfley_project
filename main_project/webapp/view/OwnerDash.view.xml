<mvc:View
    xmlns:core="sap.ui.core"
    controllerName="com.applexus.mainproject.controller.OwnerDash"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page3"
        title="{i18n>title}"
    >
        <customHeader>
            <Toolbar height="60px">
                <Title
                    text="TURFLEY"
                    level="H1"
                    titleStyle="H2"
                />
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true"
                />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    text="Welcome, Owner"
                    level="H1"
                    titleStyle="H2"
                />
                <HBox
                    justifyContent="SpaceBetween"
                    width="100%"
                >
                    <Title
                        text="List of Turfs"
                        level="H1"
                        titleStyle="H4"
                        class="sapUiSmallMarginTop"
                    />

                    <Button
                        text="View My Bookings"
                        type="Emphasized"
                        press="onViewMyBookings"
                    />
                </HBox>

                <Table
                    class="sapUiSmallMarginTop"
                    items="{turfModel>/turfs}"
                >
                    <columns>
                        <Column>
                            <Title text="Turf Name" />
                        </Column>
                        <Column>
                            <Title text="Turf Location" />
                        </Column>
                        <Column>
                            <Title text="Turf Type" />
                        </Column>
                        <Column>
                            <Title text="Turf Status" />
                        </Column>
                        <Column>
                            <Title text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{turfModel>Turf_Name}" />
                                <Text text="{turfModel>Turf_Location}" />
                                <Text text="{turfModel>Turf_Type_Text}" />
                                <Text text="{turfModel>Status_turf}" />

                                <Button
                                    icon="sap-icon://edit"
                                    type="Emphasized"
                                    press="onEditTurf"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <Button
                    text="Add New Turf Here"
                    type="Emphasized"
                    press="onAdd"
                    class="sapUiMediumMarginTop"
                />
            </VBox>
        </content>
    </Page>
</mvc:View>
