<mvc:View 
    xmlns:core="sap.ui.core" 
    controllerName="com.applexus.mainproject.controller.OwnerDash"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page id="ownerDash">
        <customHeader>
            <Toolbar height="60px">
                <Title
                    text="TURFLEY"
                    level="H1"
                    titleStyle="H2"/>
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true"/>
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    text="Welcome, Owner"
                    level="H1"
                    titleStyle="H2"/>

                <HBox
                    justifyContent="SpaceBetween"
                    width="100%"
                    class="sapUiSmallMarginTop">
                    <Title
                        text="TURF MANAGEMENT"
                        level="H3"
                        titleStyle="H3"/>
                    <HBox>
                        <Button
                            text="Turf Bookings"
                            type="Emphasized"
                            press="onViewMyBookings"
                            class="sapUiTinyMarginEnd"/>
                        <Button
                            text="Add New Turf"
                            type="Emphasized"
                            press="onAdd"
                            class="sapUiTinyMarginEnd"/>
                        <Button
                            text="Logout"
                            icon="sap-icon://log"
                            press="onLogout"
                            type="default"/>
                    </HBox>
                </HBox>

                <smartFilterBar:SmartFilterBar
                    id="smartFilterBar1"
                    entitySet="ZIB18_GRP1_OWNERSet"
                    showGoOnFB="true"
                    search="onFilterSearch">
                    <smartFilterBar:controlConfiguration>
                        <smartFilterBar:ControlConfiguration
                            key="p_ownerid"
                            mandatory="notMandatory"
                            visible="false"/>
                    </smartFilterBar:controlConfiguration>
                </smartFilterBar:SmartFilterBar>

                <smartTable:SmartTable
                    id="smartTableOwn"
                    entitySet="ZIB18_GRP1_OWNERSet"
                    smartFilterId="smartFilterBar1"
                    tableType="ResponsiveTable"
                    useVariantManagement="true"
                    useTablePersonalisation="true"
                    enableAutoBinding="true"
                    beforeRebindTable="onBeforeRebind"
                    header="Turfs"
                    showRowCount="true">

                    <Table>
                        <columns>
                            <Column hAlign="Center" width="8rem">
                                <customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"Actions","columnIndex":"99"\}'/>
                                </customData>
                                <header>
                                    <Text text="Actions" />
                                </header>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Button
                                        text="Edit"
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        press="onEditTurf"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </smartTable:SmartTable>
            </VBox>
        </content>
    </Page>
</mvc:View>