<mvc:View xmlns:core="sap.ui.core" controllerName="com.applexus.mainproject.controller.OwnerDash"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page3" title="{i18n>title}">
    <customHeader>
            <Toolbar height="60px">
           
            <!-- To display TURFLEY on the Left Side -->
                <Title text="TURFLEY" level="H1" titleStyle="H2" />    
 
            <!-- This will push Logo to the Right Side -->
                <ToolbarSpacer />
 
            <!-- Logo of Turfley  -->
                <Image
                src="../Images/justlogo.png"
                width="70px"
                height="70px"
                decorative="true" />
            </Toolbar>
    </customHeader>
    
    <content>
        <VBox class="sapUiMediumMargin">

            <Title  text="Welcome, Owner" level="H1" titleStyle="H2" /> 
            <Title  text="List of Turfs" level="H1" titleStyle="H4" class="sapUiSmallMarginTop" /> 

            <Table class="sapUiSmallMarginTop">
                <columns>
                    <Column >
                        <Title text="Turf Name" ></Title>               
                    </Column>  
                    <Column >
                        <Title text="Turf Location" ></Title>               
                    </Column>
                    <Column >
                        <Title text="Turf Type" ></Title>               
                    </Column>
                    <Column >
                        <Title text="Actions" ></Title>               
                    </Column>

                </columns>   
            </Table>
            <Button text="Add New Turf Here" type="Emphasized" press="onAdd" class="sapUiMediumMarginTop"></Button>


    
    
    
    
    
    
    
    
        </VBox>
    </content>
 

 
 
       
    </Page>
</mvc:View>
 



