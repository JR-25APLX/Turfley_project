                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>

                            </l:Grid>
                        </Panel>

                        <Button text="BOOK NOW"
                                press="onBookNow"
                                type="Emphasized"
                                width="100%"
                                class="sapUiSmallMarginTop"/>
                    </VBox>
                </Panel>
            </FlexBox>
        </ScrollContainer>
    </Page>
</mvc:View>