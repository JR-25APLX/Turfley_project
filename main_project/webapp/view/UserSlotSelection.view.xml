<mvc:View controllerName="com.applexus.mainproject.controller.UserSlotSelection"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">

    <Page title="TURFLEY" enableScrolling="true">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1"/>
                <ToolbarSpacer/>
                <Image src="../Images/justlogo.png" width="70px" height="70px"/>
            </Toolbar>
        </customHeader>

        <ScrollContainer height="100%" width="100%" vertical="true">
            <FlexBox width="100%" justifyContent="Center" alignItems="Center">
                <Panel width="750px" class="sapUiResponsiveMargin">
                    <VBox class="sapUiMediumMargin">

                        <Label text="Turf Name"/>
                        <Input value="{viewModel>/turfName}" editable="false"/>

                        <Label text="Location"/>
                        <Input value="{viewModel>/turfLocation}" editable="false"/>

                        <Label text="Date"/>
                        <DatePicker id="datePicker"
                                    change="onDateChange"
                                    displayFormat="dd/MM/yyyy"/>

                        <HBox class="sapUiSmallMarginTop">
                            <Button text="Available" type="Accept" enabled="false" class="sapUiSmallMarginEnd"/>
                            <Button text="Booked"    type="Reject" enabled="false" class="sapUiSmallMarginEnd"/>
                            <Button text="Selected"  type="Emphasized" enabled="false"/>
                        </HBox>

                        <Panel class="sapUiSmallMarginTop">
                            <l:Grid id="slotGrid" defaultSpan="L3 M4 S6">

                                <Button text="12 - 01 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="0"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="01 - 02 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="1"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="02 - 03 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="2"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="03 - 04 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="3"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="04 - 05 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="4"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="05 - 06 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="5"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
                                    <customData><core:CustomData key="slotId"    value=""/></customData>
                                </Button>
                                <Button text="06 - 07 AM" press="onSlotPress" type="Default" enabled="false">
                                    <customData><core:CustomData key="startHour" value="6"/></customData>
                                    <customData><core:CustomData key="status"    value=""/></customData>
