<mvc:View 
    controllerName="com.applexus.mainproject.controller.UserSlotSelection"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">

    <Page id="slotSelection" enableScrolling="true">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true" />
            </Toolbar>
        </customHeader>

        <VBox class="sapUiSmallMargin"> 
            <Title 
                text="SELECT YOUR SLOTS" 
                level="H2" 
                titleStyle="H3" 
                class="sapUiSmallMargin" />

            <ScrollContainer height="100%" width="100%" vertical="true">
                <FlexBox width="100%" justifyContent="Center" alignItems="Center">
                    <Panel width="750px" class="sapUiResponsiveMargin">
                        <VBox class="sapUiMediumMargin">

                            <Label text="Turf Name"/>
                            <Input value="{viewModel>/turfName}" editable="false"/>

                            <Label text="Location"/>
                            <Input value="{viewModel>/turfLocation}" editable="false"/>

                            <Label text="Price (per slot)"/>
                            <Input value="₹ {viewModel>/basePrice}" editable="false"/>

                            <Label text="Date"/>
                            <DatePicker 
                                id="datePicker"
                                change="onDateChange"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="yyyy-MM-dd"/> 

                            <HBox class="sapUiSmallMarginTop">
                                <Button text="Available" type="Accept" enabled="false" class="sapUiSmallMarginEnd"/>
                                <Button text="Booked" type="Reject" enabled="false" class="sapUiSmallMarginEnd"/>
                                <Button text="Selected" type="Emphasized" enabled="false"/>
                            </HBox>

                            <core:Fragment 
                                id="slotfragment"
                                fragmentName="com.applexus.mainproject.fragments.SlotSelection" 
                                type="XML" />

                            <Button 
                                text="BOOK NOW"
                                press="onBookNow"
                                type="Emphasized"
                                width="100%"
                                class="sapUiSmallMarginTop"/>
                        </VBox>
                    </Panel>
                </FlexBox>
            </ScrollContainer>
        </VBox>
    </Page>
</mvc:View>