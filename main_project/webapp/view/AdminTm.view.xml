<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:g="sap.ui.layout" controllerName="com.applexus.mainproject.controller.AdminTm">
<Page id="page6" title="{i18n>title}">
<customHeader>
<Toolbar height="60px">
<Title text="TURFLEY" level="H1" titleStyle="H2"/>
<ToolbarSpacer/>
<Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true"/>
</Toolbar>
</customHeader>
<content>
<VBox class="sapUiMediumMargin">
<Title text="TURF MANAGEMENT" level="H2"/>
<IconTabBar class="sapUiSmallMarginTop" select="onTabSelect">
<items>
<IconTabFilter text="Add New Turf Here" key="Add">
<VBox class="sapUiSmallMarginTop">
<g:Grid defaultSpan="L4 M6 S12">
<VBox>
<Label text="Enter Turf Name"/>
<Input value="{turfModel>/Name}" placeholder="e.g. Green Field"/>
</VBox>
<VBox>
<Label text="Enter Turf Location"/>
<Input value="{turfModel>/Location}" placeholder="e.g. Trivandrum"/>
</VBox>
<VBox>
<Label text="Turf Type"/>
<Select selectedKey="{turfModel>/Type}">
<items>
<core:Item xmlns:core="sap.ui.core" key="" text="-- Select Type --"/>
<core:Item xmlns:core="sap.ui.core" key="C" text="C - Cricket"/>
<core:Item xmlns:core="sap.ui.core" key="B" text="B - Badminton"/>
<core:Item xmlns:core="sap.ui.core" key="F" text="F - Football"/>
</items>
</Select>
</VBox>
</g:Grid>
<g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
<VBox>
<Label text="Enter Turf Location URL"/>
<Input value="{turfModel>/Locationurl}" placeholder="https://maps.google.com/..."/>
</VBox>
<VBox>
<Label text="Currency"/>
<Input value="{turfModel>/Cuky}" enabled="false"/>
</VBox>
<VBox>
<Label text="Enter Commission (%)"/>
<Input value="{turfModel>/Commission_Perc}" type="Number" placeholder="e.g. 10"/>
</VBox>
</g:Grid>
<g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
<VBox>
<Label text="Enter Turf Price"/>
<Input value="{turfModel>/Price}" type="Number" placeholder="e.g. 500"/>
</VBox>
<VBox>
<Label text="Enter Owner Email"/>
<Input value="{turfModel>/Owner}" placeholder="e.g. owner@gmail.com"/>
</VBox>
</g:Grid>
<HBox class="sapUiSmallMarginTop" renderType="Bare">
<Button text="Add Slots" icon="sap-icon://add" type="Emphasized" press="onAddSlots" class="sapUiSmallMarginEnd"/>
<Button text="Add" icon="sap-icon://save" type="Emphasized" press="onAdd"/>
</HBox>
</VBox>
</IconTabFilter>
<IconTabFilter text="Edit Turf Here" key="Edit">
<Table id="turfEditTable" items="{path: '/TurfSet'}">
<columns>
<Column>
<Title text="Turf ID"/>
</Column>
<Column>
<Title text="Turf Name"/>
</Column>
<Column>
<Title text="Turf Location"/>
</Column>
<Column>
<Title text="Turf Type"/>
</Column>
<Column>
<Title text="Owner"/>
</Column>
<Column>
<Title text="Price"/>
</Column>
<Column>
<Title text="Edit"/>
</Column>
<Column>
<Title text="Status"/>
</Column>
</columns>
<items>
<ColumnListItem>
<cells>
<Text text="{Id}"/>
<Text text="{Name}"/>
<Text text="{Location}"/>
<Text text="{Type}"/>
<Text text="{Owner}"/>
<Text text="{Price}"/>
<Button icon="sap-icon://edit" press="onEditTurf"/>
<Switch type="AcceptReject" change="onStatusChange"/>
</cells>
</ColumnListItem>
</items>
</Table>
</IconTabFilter>
<IconTabFilter text="Approvals" key="Approvals">
<VBox class="sapUiMediumMargin">
<Table id="pendingTurfTable" items="{ path: '/TurfSet', filters: [{ path: 'Status', operator: 'EQ', value1: 'P' }] }" noDataText="No pending approvals.">
<columns>
<Column>
<Title text="Turf ID"/>
</Column>
<Column>
<Title text="Turf Name"/>
</Column>
<Column>
<Title text="Location"/>
</Column>
<Column>
<Title text="Type"/>
</Column>
<Column>
<Title text="Owner"/>
</Column>
<Column>
<Title text="Price"/>
</Column>
<Column>
<Title text="Action"/>
</Column>
</columns>
<items>
<ColumnListItem>
<cells>
<Text text="{Id}"/>
<Text text="{Name}"/>
<Text text="{Location}"/>
<Text text="{Type}"/>
<Text text="{Owner}"/>
<Text text="{Price}"/>
<Button text="Approve" icon="sap-icon://accept" type="Accept" press="onApproveTurf"/>
</cells>
</ColumnListItem>
</items>
</Table>
</VBox>
</IconTabFilter>
</items>
</IconTabBar>
</VBox>
</content>
</Page>
</mvc:View>