<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:g="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    controllerName="com.applexus.mainproject.controller.AdminTm">

    <Page id="adminTm">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true" />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="TURF MANAGEMENT" level="H2" titleStyle="H3"/>

                <IconTabBar id="adminTmTabBar" select="onTabSelect" selectedKey="Add">
                    <items>
                        <IconTabFilter text="Add New Turf Here" key="Add" titleStyle="H4">
                            <VBox class="sapUiSmallMarginTop">
                                <g:Grid defaultSpan="L4 M6 S12">
                                    <VBox>
                                        <Label text="Enter Turf Name" />
                                        <Input value="{turfModel>/Name}" placeholder="e.g. Green Field" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Turf Location" />
                                        <Input value="{turfModel>/Location}" placeholder="e.g. Trivandrum" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Turf Type" />
                                        <Select selectedKey="{turfModel>/Type}">
                                            <items>
                                                <core:Item key="" text="-- Select Type --" />
                                                <core:Item key="C" text="C - Cricket" />
                                                <core:Item key="B" text="B - Badminton" />
                                                <core:Item key="F" text="F - Football" />
                                            </items>
                                        </Select>
                                    </VBox>
                                </g:Grid>

                                <g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
                                    <VBox>
                                        <Label text="Enter Turf Location URL" />
                                        <Input value="{turfModel>/Locationurl}" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Currency" />
                                        <Input value="{turfModel>/Cuky}" enabled="false" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Commission (%)" />
                                        <Input value="{turfModel>/Commission_Perc}" type="Number" />
                                    </VBox>
                                </g:Grid>

                                <g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
                                    <VBox>
                                        <Label text="Enter Turf Price" />
                                        <Input value="{turfModel>/Price}" type="Number" />
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Owner Email" />
                                        <Input value="{turfModel>/Owner}" />
                                    </VBox>
                                </g:Grid>

                                <HBox class="sapUiSmallMarginTop" renderType="Bare">
                                    <Button text="Add Slots" icon="sap-icon://add" type="Emphasized" press="onAddSlots" class="sapUiSmallMarginEnd" />
                                    <Button text="Add" icon="sap-icon://save" type="Emphasized" press="onAdd" />
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <IconTabFilter text="Edit Turf Here" key="Edit" titleStyle="H4">
                            <VBox class="sapUiSmallMargin">
                                <smartFilterBar:SmartFilterBar
                                    id="turfEditFilterBar"
                                    entitySet="ZIB18_GRP1_AD_TURFS"
                                    showGoOnFB="true">
                                    <smartFilterBar:controlConfiguration>
                                        <smartFilterBar:ControlConfiguration key="Name" visible="true" index="1" />
                                        <smartFilterBar:ControlConfiguration key="Location" visible="true" index="2" />
                                        <smartFilterBar:ControlConfiguration key="TurfType" visible="true" index="3" />
                                        <smartFilterBar:ControlConfiguration key="Status" visible="true" index="4" />
                                    </smartFilterBar:controlConfiguration>
                                </smartFilterBar:SmartFilterBar>

                                <smartTable:SmartTable
                                    id="turfEditSmartTable"
                                    entitySet="ZIB18_GRP1_AD_TURFS"
                                    smartFilterId="turfEditFilterBar"
                                    tableType="ResponsiveTable"
                                    useTablePersonalisation="true"
                                    header="All Turfs"
                                    showRowCount="true"
                                    enableAutoBinding="true"
                                    requestAtLeastFields="TurfId,commission_percent,Status"
                                    initiallyVisibleFields="Name,Location,TurfType,TurfOwner,BasePrice,Status">
                                    <Table id="turfEditTable">
                                        <columns>
                                            <Column hAlign="Center">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "EditCol", "columnIndex": 100\}' />
                                                </customData>
                                                <Text text="Edit" />
                                            </Column>
                                            <Column hAlign="Center">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "StatusSwitchCol", "columnIndex": 101, "leadingProperty": "Status"\}' />
                                                </customData>
                                                <Text text="Action" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Button icon="sap-icon://edit" press="onEditTurf" />
                                                    <Switch
                                                        type="AcceptReject"
                                                        state="{path: 'Status', formatter: '.formatStatusSwitch'}"
                                                        change="onStatusChange" />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </smartTable:SmartTable>
                            </VBox>
                        </IconTabFilter>

                        <IconTabFilter text="Approvals" key="Approvals" titleStyle="H4">
                            <VBox class="sapUiSmallMargin">
                                <smartFilterBar:SmartFilterBar
                                    id="turfapprovalFilterBar"
                                    entitySet="ZIB18_GRP1_AD_APPROVALS"
                                    showGoOnFB="true">
                                    <smartFilterBar:controlConfiguration>
                                        <smartFilterBar:ControlConfiguration key="Name" visible="true" index="1" />
                                        <smartFilterBar:ControlConfiguration key="Location" visible="true" index="2" />
                                        <smartFilterBar:ControlConfiguration key="Type" visible="true" index="3" />
                                    </smartFilterBar:controlConfiguration>
                                </smartFilterBar:SmartFilterBar>

                                <smartTable:SmartTable
                                    id="approvalsSmartTable"
                                    entitySet="ZIB18_GRP1_AD_APPROVALS"
                                    tableType="ResponsiveTable"
                                    useTablePersonalisation="true"
                                    header="Turfs Awaiting Approval"
                                    showRowCount="true"
                                    enableAutoBinding="true"
                                    smartFilterId="turfapprovalFilterBar"
                                    requestAtLeastFields="TurfId"
                                    initiallyVisibleFields="Name,Location,Type,Owner,Price">
                                    <Table id="approvalsInnerTable">
                                        <columns>
                                            <Column hAlign="End">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "Action", "columnIndex": 100\}' />
                                                </customData>
                                                <Text text="Action" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Button text="Approve" icon="sap-icon://accept" type="Accept" press="onApprove" />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </smartTable:SmartTable>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>