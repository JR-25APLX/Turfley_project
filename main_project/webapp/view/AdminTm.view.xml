<mvc:View 
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:g="sap.ui.layout" 
    xmlns:core="sap.ui.core"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    controllerName="com.applexus.mainproject.controller.AdminTm">
    
    <Page id="page6" title="{i18n>title}">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2"/>
                <ToolbarSpacer/>
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true"/>
            </Toolbar>
        </customHeader>
        
        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="TURF MANAGEMENT" level="H2"/>
                
                <IconTabBar class="sapUiSmallMarginTop" select="onTabSelect" id="adminTmTabBar" selectedKey="Add">
                    <items>
                        <IconTabFilter text="Add New Turf Here" key="Add">
                            <VBox class="sapUiSmallMarginTop">
                                <g:Grid defaultSpan="L4 M6 S12">
                                    <VBox>
                                        <Label text="Enter Turf Name"/>
                                        <Input value="{turfModel>/Name}" placeholder="e.g. Green Field"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Turf Location"/>
                                        <Input value="{turfModel>/Location}" placeholder="e.g. Trivandrum"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Turf Type"/>
                                        <Select selectedKey="{turfModel>/Type}">
                                            <items>
                                                <core:Item key="" text="-- Select Type --"/>
                                                <core:Item key="C" text="C - Cricket"/>
                                                <core:Item key="B" text="B - Badminton"/>
                                                <core:Item key="F" text="F - Football"/>
                                            </items>
                                        </Select>
                                    </VBox>
                                </g:Grid>
                                <g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
                                    <VBox>
                                        <Label text="Enter Turf Location URL"/>
                                        <Input value="{turfModel>/Locationurl}" placeholder="http://maps.google.com/..."/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Currency"/>
                                        <Input value="{turfModel>/Cuky}" enabled="false"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Commission (%)"/>
                                        <Input value="{turfModel>/Commission_Perc}" type="Number" placeholder="e.g. 10"/>
                                    </VBox>
                                </g:Grid>
                                <g:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginTop">
                                    <VBox>
                                        <Label text="Enter Turf Price"/>
                                        <Input value="{turfModel>/Price}" type="Number" placeholder="e.g. 500"/>
                                    </VBox>
                                    <VBox>
                                        <Label text="Enter Owner Email"/>
                                        <Input value="{turfModel>/Owner}" placeholder="e.g. owner@gmail.com"/>
                                    </VBox>
                                </g:Grid>
                                <HBox class="sapUiSmallMarginTop" renderType="Bare">
                                    <Button text="Add Slots" icon="sap-icon://add" type="Emphasized" press="onAddSlots" class="sapUiSmallMarginEnd"/>
                                    <Button text="Add" icon="sap-icon://save" type="Emphasized" press="onAdd"/>
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <IconTabFilter text="Edit Turf Here" key="Edit">
                            <VBox class="sapUiSmallMargin">
                                <smartTable:SmartTable 
                                    id="turfEditSmartTable"
                                    entitySet="TurfSet"
                                    smartFilterId="turfEditFilterBar"
                                    tableType="ResponsiveTable"
                                    useTablePersonalisation="true"
                                    header="All Turfs"
                                    showRowCount="true"
                                    enableAutoBinding="true"
                                    requestAtLeastFields="Id,Status"
                                    initiallyVisibleFields="Id,Name,Location,Type,Owner,Price">
                                    
                                    <Table id="turfEditTable">
                                        <columns>
                                            <Column hAlign="Center">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "EditCol", "columnIndex": 100\}' />
                                                </customData>
                                                <Text text="Edit" />
                                            </Column>
                                            <Column hAlign="Center">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "StatusCol", "columnIndex": 101, "leadingProperty": "Status"\}' />
                                                </customData>
                                                <Text text="Status" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Button icon="sap-icon://edit" press="onEditTurf" />
                                                    <Switch 
                                                        type="AcceptReject" 
                                                        state="{path: 'Status', formatter: '.formatStatusSwitch'}" 
                                                        change="onStatusChange" />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </smartTable:SmartTable>
                            </VBox>
                        </IconTabFilter>

                        <IconTabFilter text="Approvals" key="Approvals">
                            <VBox class="sapUiSmallMargin">
                                <smartTable:SmartTable 
                                    id="approvalsSmartTable"
                                    entitySet="ZIB18_GRP1_AD_APPROVALS"
                                    smartFilterId="approvalsFilterBar"
                                    tableType="ResponsiveTable"
                                    useTablePersonalisation="true"
                                    header="Turfs Awaiting Approval"
                                    showRowCount="true"
                                    enableAutoBinding="true"
                                    requestAtLeastFields="TurfId,Status"
                                    initiallyVisibleFields="TurfId,Name,Location,TurfType,Owner,Price">

                                    <Table id="approvalsInnerTable">
                                        <columns>
                                            <Column hAlign="End">
                                                <customData>
                                                    <core:CustomData key="p13nData" value='\{"columnKey": "Action", "columnIndex": 100\}' />
                                                </customData>
                                                <Text text="Action" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Button 
                                                        text="Approve" 
                                                        icon="sap-icon://accept" 
                                                        type="Accept" 
                                                        press="onApproveTurf"/>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </smartTable:SmartTable>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>