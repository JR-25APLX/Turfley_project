<mvc:View
    controllerName="com.applexus.mainproject.controller.AdminUm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page id="adminUm">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true" />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title 
                    text="USER MANAGEMENT" 
                    level="H2" 
                    titleStyle="H3" 
                    class="sapUiSmallMargin" />

                <smartFilterBar:SmartFilterBar
                    id="userFilterBar"
                    entitySet="ZIB18_GRP1_USER"
                    persistencyKey="PKeyUserFilter"/>

                <smartTable:SmartTable
                    id="userSmartTable"
                    entitySet="ZIB18_GRP1_USER"
                    smartFilterId="userFilterBar"
                    tableType="ResponsiveTable"
                    useTablePersonalisation="true"
                    header="Users"
                    showRowCount="true"
                    enableAutoBinding="true">

                    <Table id="innerUserTable">
                        <columns>
                            <Column hAlign="End">
                                <customData>
                                    <core:CustomData 
                                        key="p13nData" 
                                        value='\{"columnKey": "StatusSwitchCol", "leadingProperty": "Status", "columnIndex": 100\}' />
                                </customData>
                                <Text text="Action" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                <Switch
                                    type="AcceptReject"
                                    state="{
                                        path: 'Status',
                                        formatter: '.formatStatusSwitch'
                                    }"
                                    change="onBlockUnblock"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </smartTable:SmartTable>
            </VBox>
        </content>
    </Page>
</mvc:View>