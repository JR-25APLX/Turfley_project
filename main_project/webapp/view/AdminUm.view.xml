<mvc:View
    controllerName="com.applexus.mainproject.controller.AdminUm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="PageAdminUm">
        <customHeader>
            <Toolbar height="60px">
                <Title
                    text="TURFLEY"
                    level="H1"
                    titleStyle="H2"
                />
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true"
                />
            </Toolbar>
        </customHeader>
 
        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    text="USER MANAGEMENT"
                    titleStyle="H4"
                    class="sapUiSmallMarginBottom"
                />
 
                <Table
                    id="userTable"
                    items="{userModel>/users}"
                >
                    <columns>
                        <Column>
                            <Text text="User ID" />
                        </Column>
                        <Column>
                            <Text text="Name" />
                        </Column>
                        <Column>
                            <Text text="Role" />
                        </Column>
                        <Column>
                            <Text text="Phone" />
                        </Column>
                        <Column>
                            <Text text="Status" />
                        </Column>
                        <Column>
                            <Text text="Action" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{userModel>UserId}" />
                                <Text text="{userModel>Name}" />
                                <Text text="{userModel>role_full}" />
                                <Text text="{userModel>Phone}" />
                                <Text text="{userModel>status_full}" />
                                <Button
                                    text="{= ${userModel>Status} === 'B' ? 'Unblock' : 'Block'}"
                                    type="{= ${userModel>Status} === 'B' ? 'Accept' : 'Reject'}"
                                    press="onBlockUnblock"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
 