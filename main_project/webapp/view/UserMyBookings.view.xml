<mvc:View controllerName="com.applexus.mainproject.controller.UserMyBookings"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page backgroundDesign="List">

        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true" />
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="MY BOOKINGS" level="H1"/>
                <IconTabBar class="sapUiSmallMarginTop" select="onTabSelect" id="bookingTabs">
                    <items>
                        <IconTabFilter text="Active Bookings" key="Active"/>
                        <IconTabFilter text="Past Bookings" key="Past"/>
                    </items>
                </IconTabBar>
                <Table id="myBookings">
                    <columns>
                        <Column><Text text="Booking ID"/></Column>
                        <Column><Text text="Turf Name"/></Column>
                        <Column><Text text="Location"/></Column>
                        <Column><Text text="Booking Date"/></Column>
                        <Column><Text text="Amount Paid"/></Column>
                        <Column id="actions"><Text text="Actions"/></Column>
                    </columns>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>