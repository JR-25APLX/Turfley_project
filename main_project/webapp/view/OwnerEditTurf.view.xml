<mvc:View
    controllerName="com.applexus.mainproject.controller.OwnerEditTurf"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:g="sap.ui.layout"
>
    <Page
        id="ownerEditTurf"
        title="{i18n>title}"
    >
        <customHeader>
            <Toolbar height="60px">
                <Title
                    text="TURFLEY"
                    level="H1"
                    titleStyle="H2"
                />
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true"
                />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    text="EDIT YOUR TURF HERE"
                    level="H1"
                    titleStyle="H3"
                />

                <!-- Row 1 -->
                <g:Grid
                    defaultSpan="L4 M6 S12"
                    class="sapUiSmallMarginTop"
                >
                    <VBox>
                        <Label text="Turf Name" />
                        <Input
                            value="{turfModel>/Name}"
                            placeholder="e.g. Green Field"
                        />
                    </VBox>
                    <VBox>
                        <Label text="Turf Location" />
                        <Input
                            value="{turfModel>/Location}"
                            placeholder="e.g. Trivandrum"
                        />
                    </VBox>
                    <VBox>
                        <Label text="Turf Type" />
                        <Select selectedKey="{turfModel>/Type}">
                            <items>
                                <core:Item
                                    key=""
                                    text="-- Select Type --"
                                />
                                <core:Item
                                    key="C"
                                    text="C - Cricket"
                                />
                                <core:Item
                                    key="B"
                                    text="B - Badminton"
                                />
                                <core:Item
                                    key="F"
                                    text="F - Football"
                                />
                            </items>
                        </Select>
                    </VBox>
                </g:Grid>

                <!-- Row 2 -->
                <g:Grid
                    defaultSpan="L4 M6 S12"
                    class="sapUiSmallMarginTop"
                >
                    <VBox>
                        <Label text="Turf Location URL" />
                        <Input
                            value="{turfModel>/Locationurl}"
                            placeholder="https://maps.google.com/..."
                        />
                    </VBox>
                    <VBox>
                        <Label text="Turf Price" />
                        <Input
                            value="{turfModel>/Price}"
                            type="Number"
                            placeholder="e.g. 500"
                        />
                    </VBox>
                    <VBox>
                        <Label text="Currency" />
                        <Input
                            value="{turfModel>/Cuky}"
                            enabled="false"
                        />
                    </VBox>
                </g:Grid>

                <!-- Buttons -->
                <HBox
                    class="sapUiSmallMarginTop"
                    renderType="Bare"
                >
                    <Button
                        text="Edit Slots"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        press="onEditSlots"
                        class="sapUiSmallMarginEnd"
                    />
                    <Button
                        text="Save"
                        icon="sap-icon://save"
                        type="Emphasized"
                        press="onSave"
                    />
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
