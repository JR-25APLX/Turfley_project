<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Dialog
        id="addSlotsDialog"
        title="Add Slots"
        contentWidth="520px"
        draggable="true"
        resizable="false"
        class="addSlotsDialogContainer">

        <content>
            <VBox class="slotDialogContent" fitContainer="true">

                <!-- Turf ID Display -->
                <HBox alignItems="Center" class="turfIdBar">
                    <core:Icon src="sap-icon://map" class="turfIcon"/>
                    <Label text="Turf ID:" class="turfIdLabel"/>
                    <Text id="dialogTurfIdText" text="" class="turfIdValue"/>
                </HBox>

                <Text
                    text="Tap a slot to select it. Selected slots will be saved to the database."
                    class="slotInstructions"/>

                <!-- Slot Grid Header -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="slotGridHeader">
                    <Text text="Available Time Slots (24 Hours)" class="slotGridTitle"/>
                    <HBox class="legendBox">
                        <core:Icon src="sap-icon://circle-task" color="#22c55e" class="legendIcon"/>
                        <Text text="Selected" class="legendText"/>
                        <core:Icon src="sap-icon://circle-task" color="#94a3b8" class="legendIcon legendIconGap"/>
                        <Text text="Available" class="legendText"/>
                    </HBox>
                </HBox>

                <!-- Slot Buttons Grid -->
                <l:Grid
                    id="slotGrid"
                    defaultSpan="XL3 L3 M4 S6"
                    class="slotButtonGrid">
                    <!-- Slots are rendered dynamically via controller -->
                </l:Grid>

                <!-- Selected count info -->
                <HBox alignItems="Center" justifyContent="Center" class="selectedCountBar">
                    <core:Icon src="sap-icon://accept" class="selectedCountIcon"/>
                    <Text id="selectedCountText" text="0 slot(s) selected" class="selectedCountText"/>
                </HBox>

            </VBox>
        </content>

        <beginButton>
            <Button
                id="saveSlotBtn"
                text="Save Slots"
                type="Success"
                icon="sap-icon://save"
                press="onSaveSlots"
                class="saveSlotsBtn"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                type="Transparent"
                icon="sap-icon://decline"
                press="onCancelSlots"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>