<mvc:View
    controllerName="com.applexus.mainproject.controller.OwnerAddTurf"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:g="sap.ui.layout"
>
    <Page
        id="page5"
        title="{i18n>title}"
    >
        <customHeader>
            <Toolbar height="60px">
                <Title
                    text="TURFLEY"
                    level="H1"
                    titleStyle="H2"
                />
                <ToolbarSpacer />
                <Image
                    src="../Images/justlogo.png"
                    width="70px"
                    height="70px"
                    decorative="true"
                />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title
                    text="ADD YOUR NEW TURF HERE"
                    level="H1"
                    titleStyle="H3"/>
                <g:Grid
                    defaultSpan="L4 M6 S12"
                    class="sapUiSmallMarginTop">
                    <VBox>
                        <Label text="Enter Turf Name" />
                        <Input
                            value="{turfModel>/Name}"
                            placeholder="e.g. Green Field"/>
                    </VBox>
                    <VBox>
                        <Label text="Enter Turf Location" />
                        <Input
                            value="{turfModel>/Location}"
                            placeholder="e.g. Trivandrum"/>
                    </VBox>
                    <VBox>
                        <Label text="Turf Type" />
                        <Select selectedKey="{turfModel>/Type}">
                            <items>
                                <core:Item
                                    key=""
                                    text="-- Select Type --"/>
                                <core:Item
                                    key="C"
                                    text="C - Cricket" />
                                <core:Item
                                    key="B"
                                    text="B - Badminton"/>
                                <core:Item
                                    key="F"
                                    text="F - Football"/>
                            </items>
                        </Select>
                    </VBox>
                </g:Grid>

                <g:Grid
                    defaultSpan="L4 M6 S12"
                    class="sapUiSmallMarginTop"
                >
                    <VBox>
                        <Label text="Enter Turf Location URL" />
                        <Input
                            value="{turfModel>/Locationurl}"
                            placeholder="https://maps.google.com/..."
                        />
                    </VBox>
                    <VBox>
                        <Label text="Currency" />
                        <Input
                            value="{turfModel>/Cuky}"
                            enabled="false"
                        />
                    </VBox>
                </g:Grid>

                <g:Grid
                    defaultSpan="L4 M6 S12"
                    class="sapUiSmallMarginTop">
                    <VBox>
                        <Label text="Enter Turf Price" />
                        <Input
                            value="{turfModel>/Price}"
                            type="Number"
                            placeholder="e.g. 500"/>
                    </VBox>
                    <VBox>
                        <Label text="Enter Owner Email" />
                        <Input
                            value="{turfModel>/Owner}"
                            editable="false"
                            placeholder="e.g. owner@gmail.com"/>
                    </VBox>
                </g:Grid>
                <HBox
                    class="sapUiSmallMarginTop"
                    renderType="Bare">
                    <Button
                        text="Add Slots"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press="onAddSlots"
                        class="sapUiSmallMarginEnd"/>
                    <Button
                        text="Submit"
                        icon="sap-icon://save"
                        type="Emphasized"
                        press="onAdd"/>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
