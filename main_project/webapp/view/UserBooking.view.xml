<mvc:View controllerName="com.applexus.mainproject.controller.UserBooking"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page enableScrolling="true" backgroundDesign="List">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2"/>
                <ToolbarSpacer/>
                <Image src="../Images/justlogo.png" 
                       width="50px" 
                       height="70px" 
                       decorative="true"/>
            </Toolbar>
        </customHeader>

        <content>
            <FlexBox width="100%" 
                     alignItems="Center" 
                     justifyContent="Center" 
                     class="sapUiMediumMargin">
                <Panel width="600px" 
                       backgroundDesign="Solid" 
                       class="sapUiResponsiveMargin">
                    <content>
                        <VBox class="sapUiMediumMargin">
                            <Title text="Booking Summary" 
                                   titleStyle="H2" 
                                   class="sapUiSmallMarginBottom"/>

                            <Label text="Turf Name" design="Bold" />
                            <Text text="{/selectedTurf/name}" class="sapUiSmallMarginBottom"/>
                            
                            <Label text="Date &amp; Time" design="Bold" />
                            <Text text="{/bookingDate} at {/bookingTime}" class="sapUiSmallMarginBottom"/>
                            
                            <Label text="Total Amount" design="Bold" />
                            <Text text="₹ {/totalPrice}" class="sapUiMediumMarginBottom"/>

                            <HBox justifyContent="End" class="sapUiSmallMarginTop">
                                <Button text="Cancel" 
                                        type="Transparent" 
                                        press="onCancelBooking" 
                                        class="sapUiSmallMarginEnd"/>
                                <Button text="Confirm Booking" 
                                        type="Emphasized" 
                                        press="onConfirmBooking"/>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
