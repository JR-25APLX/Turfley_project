<mvc:View
    controllerName="com.applexus.mainproject.controller.AdminBm"
        xmlns:mvc="sap.ui.core.mvc"
            xmlns="sap.m"
                xmlns:g="sap.ui.layout">
                
                    <Page id="bookingsPage" showHeader="false">
                    >
        <content>
            <VBox class="sapUiMediumMargin">

                <Toolbar height="60px">
                    <Title text="TURFLEY" level="H1" titleStyle="H2" />
                    <ToolbarSpacer />
                    <Image
                        src="../Images/justlogo.png"
                        width="70px"
                        height="70px"
                        decorative="true" />
                </Toolbar>

                <Title text="BOOKINGS MANAGEMENT" level="H2" class="sapUiSmallMarginTop" />

                <IconTabBar
                    class="sapUiSmallMarginTop"
                    select="onTabSelect">
                    <items>

            
                        <IconTabFilter text="Active Bookings" key="Active">
                            <Table
                                id="activeBookingsTable"
                                items="{
                                    path: '/ActiveBookingsSet'
                                }"
                                noDataText="No active bookings found.">

                                <columns>
                                    <Column><Title text="Booking ID"/></Column>
                                    <Column><Title text="User ID"/></Column>
                                    <Column><Title text="Turf ID"/></Column>
                                    <Column><Title text="Payment ID"/></Column>
                                    <Column><Title text="Date"/></Column>
                                    <Column><Title text="Final Amount"/></Column>
                                    <Column><Title text="Curr Key"/></Column>
                                    <Column><Title text="Status"/></Column>
                                    <Column><Title text="Actions"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{Booking_Id}"/>
                                            <Text text="{User_Id}"/>
                                            <Text text="{Turf_Id}"/>
                                            <Text text="{Payment_Id}"/>
                                            <Text text="{
                                                path: 'Date',
                                                type: 'sap.ui.model.type.Date',
                                                formatOptions: { pattern: 'dd/MM/yyyy' }
                                            }"/>
                                            <Text text="{Final_Amount}"/>
                                            <Text text="{Curr_Key}"/>
                                            <ObjectStatus
                                                text="{Status}"
                                                state="{= ${Status} === 'C' ? 'Success' : 'Warning' }"/>
                                            <Button
                                                text="Cancel"
                                                type="Emphasized"
                                                press="onCancelBooking"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>

                            </Table>
                        </IconTabFilter>


                        <IconTabFilter text="Past Bookings" key="Past">
                            <Table
                                id="pastBookingsTable"
                                items="{
                                    path: '/PastBookingsSet'
                                }"
                                noDataText="No past bookings found.">

                                <columns>
                                    <Column><Title text="Booking ID"/></Column>
                                    <Column><Title text="User ID"/></Column>
                                    <Column><Title text="Turf ID"/></Column>
                                    <Column><Title text="Payment ID"/></Column>
                                    <Column><Title text="Date"/></Column>
                                    <Column><Title text="Final Amount"/></Column>
                                    <Column><Title text="Curr Key"/></Column>
                                    <Column><Title text="Status"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{Booking_Id}"/>
                                            <Text text="{User_Id}"/>
                                            <Text text="{Turf_Id}"/>
                                            <Text text="{Payment_Id}"/>
                                            <Text text="{
                                                path: 'Date',
                                                type: 'sap.ui.model.type.Date',
                                                formatOptions: { pattern: 'dd/MM/yyyy' }
                                            }"/>
                                            <Text text="{Final_Amount}"/>
                                            <Text text="{Curr_Key}"/>
                                            <ObjectStatus
                                                text="{Status}"
                                                state="{= ${Status} === 'C' ? 'Success' : 'Error' }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>

                            </Table>
                        </IconTabFilter>

                    </items>
                </IconTabBar>

            </VBox>
        </content>

    </Page>
</mvc:View>