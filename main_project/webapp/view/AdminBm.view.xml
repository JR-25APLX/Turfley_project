<mvc:View
    controllerName="com.applexus.mainproject.controller.AdminBm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page id="adminBm" backgroundDesign="List">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true" />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title 
                    text="BOOKINGS MANAGEMENT" 
                    level="H2" 
                    titleStyle="H3" 
                    class="sapUiSmallMargin" />

                <smartFilterBar:SmartFilterBar 
                    id="smartFilterBar"
                    entitySet="ZIB18_GRP1_AD_BOOKINGS"
                    showGoOnFB="true">
                    <smartFilterBar:controlConfiguration>
                        <smartFilterBar:ControlConfiguration key="BookingId" visible="true" index="1" />
                        <smartFilterBar:ControlConfiguration key="UserId" visible="true" index="2" />
                        <smartFilterBar:ControlConfiguration key="TurfName" visible="true" index="3" />
                        <smartFilterBar:ControlConfiguration key="Type" visible="true" index="4" />
                    </smartFilterBar:controlConfiguration>
                </smartFilterBar:SmartFilterBar>

                <IconTabBar 
                    id="bookingTabBar" 
                    select="onTabSelect" 
                    selectedKey="Active" 
                    class="sapUiSmallMarginTop">
                    <items>
                        <IconTabFilter text="Active" key="Active" icon="sap-icon://accept" />
                        <IconTabFilter text="Past" key="Past" icon="sap-icon://history" />
                    </items>
                </IconTabBar>

                <smartTable:SmartTable 
                    id="bookingsSmartTable"
                    entitySet="ZIB18_GRP1_AD_BOOKINGS"
                    smartFilterId="smartFilterBar"
                    tableType="ResponsiveTable"
                    useTablePersonalisation="true"
                    header="Bookings"
                    showRowCount="true"
                    enableAutoBinding="true"  
                    beforeRebindTable="onBeforeRebindTable">

                    <Table id="innerTable">
                        <columns>
                            <Column id="actionsColumn" hAlign="End">
                                <customData>
                                    <core:CustomData key="p13nData" value='\{"columnKey": "Action", "columnIndex": 100\}'/>
                                </customData>
                                <Text text="Actions" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Button 
                                        text="Cancel" 
                                        type="Reject" 
                                        press="onCancelBooking" 
                                        enabled="{parts: [{path: 'Status'}, {path: 'BookingDate'}], formatter: '.formatCancelEnabled'}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </smartTable:SmartTable>
            </VBox>
        </content>
    </Page>
</mvc:View>