<mvc:View
    controllerName="com.applexus.mainproject.controller.AdminBm"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page backgroundDesign="List">
        <customHeader>
            <Toolbar height="60px">
                <Title text="TURFLEY" level="H1" titleStyle="H2" />
                <ToolbarSpacer />
                <Image src="../Images/justlogo.png" width="70px" height="70px" decorative="true" />
            </Toolbar>
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="BOOKINGS MANAGEMENT" level="H2" />

                <IconTabBar id="bookingTabBar" select="onTabSelect" selectedKey="Active" class="sapUiSmallMarginTop">
                    <items>
                        <IconTabFilter text="Active Bookings" key="Active"/>
                        <IconTabFilter text="Past Bookings"   key="Past"/>
                    </items>
                </IconTabBar>

                <Table id="bookingsTable">

                    <columns>
                        <Column><Text text="Booking ID"/></Column>
                        <Column><Text text="User ID"/></Column>
                        <Column><Text text="Turf Name"/></Column>
                        <Column><Text text="Location"/></Column>
                        <Column><Text text="Booking Date"/></Column>
                        <Column><Text text="Amount Paid"/></Column>
                        <Column><Text text="Status"/></Column>
                        <Column id="actionsColumn"><Text text="Actions"/></Column>
                    </columns>
                                     
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>